{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "headers": [
      {
        "source": "/Vrindopnishad Web/pdf/main/pdf-viewer.html",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; font-src 'self' https://cdnjs.cloudflare.com; img-src 'self' data: https://vrindopnishad.in; connect-src 'self';"
          }
        ]
      },
      {
        "source": "/pdf",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; font-src 'self' https://cdnjs.cloudflare.com; img-src 'self' data: https://vrindopnishad.in; connect-src 'self';"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(), microphone=(), camera=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.gstatic.com https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://vrindopnishad.in https://*.supabase.co https://*.supabase.net https://*.gstatic.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.firebaseapp.com https://*.supabase.co https://*.supabase.net https://*.google-analytics.com https://*.analytics.google.com;"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "database.rules.json",
      "**/.*",
      "**/.*/**",
      "**/.git/**",
      "Projects/**",
      "**/node_modules/**",
      "**/.venv/**"
    ],
    "redirects": [
      {
        "source": "/Vrindopnishad Web/about code/main/about.html",
        "destination": "/about",
        "type": 301
      },
      {
        "source": "/Vrindopnishad Web/Pictures/main/Gallery.html",
        "destination": "/gallery",
        "type": 301
      },
      {
        "source": "/Vrindopnishad Web/Pictures/main/photos.html",
        "destination": "/photos",
        "type": 301
      },
      {
        "source": "/Vrindopnishad Web/pdf/main/pdf-viewer.html",
        "destination": "/pdf",
        "type": 301
      },
      {
        "source": "/Projects/Cloud-Kitchen/kitchen.html",
        "destination": "/kitchen",
        "type": 301
      },
      {
        "source": "/Projects/Vrinda-Tours/vrinda-tours.html",
        "destination": "/yatra",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/about",
        "destination": "/Vrindopnishad Web/about code/main/about.html"
      },
      {
        "source": "/gallery",
        "destination": "/Vrindopnishad Web/Pictures/gallery-react/dist/index.html"
      },
      {
        "source": "/photos",
        "destination": "/Vrindopnishad Web/Pictures/main/photos.html"
      },
      {
        "source": "/pdf",
        "destination": "/Vrindopnishad Web/pdf/main/pdf-viewer.html"
      },
      {
        "source": "/kitchen",
        "destination": "/Projects/Cloud-Kitchen/kitchen.html"
      },
      {
        "source": "/yatra",
        "destination": "/Projects/Vrinda-Tours/vrinda-tours.html"
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "asia-south2",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "dataconnect": {
      "dataDir": "dataconnect/.dataconnect/pgliteData"
    }
  },
  "dataconnect": {
    "source": "dataconnect"
  }
}
